# MTKC POC - Terraform Variables Example
# @author Shanaka Jayasundera - shanakaj@gmail.com
#
# Copy this file to terraform.tfvars and update values

# Azure Subscription (optional - uses az CLI default if not set)
# subscription_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Region and Environment
location           = "australiaeast"
environment        = "poc"
project_name       = "mtkc"

# AKS Configuration
kubernetes_version = "1.32.5"
aks_node_count     = 2
aks_node_vm_size   = "Standard_D2s_v3"

# HTTPS Configuration (enabled by default)
enable_https = true

# ArgoCD Configuration
# Manages all K8s resources via GitOps pattern
# Prerequisites before enabling:
#   1. Install kubelogin: brew install azure/kubelogin/kubelogin
#   2. Get AKS credentials: az aks get-credentials --resource-group rg-mtkc-poc --name aks-mtkc-poc
#   3. Convert kubeconfig: kubelogin convert-kubeconfig -l azurecli
enable_argocd        = true
argocd_chart_version = "5.55.0"
argocd_enable_ha     = false

# Azure API Management Configuration (Infrastructure Only)
# APIM instance and VNet integration are managed by Terraform
# API configurations (APIs, operations, policies) are managed by ASO via ArgoCD
# See: kubernetes/10-apim-api-config.yaml
enable_apim               = true
apim_sku_name             = "Developer_1"  # ~$50/month for POC
apim_virtual_network_type = "External"     # Public IP + VNet access to backend
apim_publisher_name       = "MTKC POC"
apim_publisher_email      = "admin@example.com"

# =============================================================================
# Azure Front Door + CDN Caching (Similar to CloudFront + S3)
# =============================================================================
enable_front_door           = true
front_door_sku              = "Premium_AzureFrontDoor"  # Required for Private Link
upload_sample_static_assets = true
enable_front_door_waf       = false  # Enable for production

# =============================================================================
# Private Link Configuration (Front Door Premium)
# Enables secure connectivity without public internet exposure
# =============================================================================
enable_private_link      = false  # Enable for production (requires Premium SKU)
enable_apim_private_link = false  # Enable Private Link for APIM origin

# Note: When enable_private_link is true:
# - Front Door connects to Internal LB via Private Link Service
# - Front Door connects to APIM via Private Endpoint (if enable_apim_private_link is true)
# - App Gateway is bypassed for web traffic (Front Door provides WAF)
